# Copy to deploy/.env; the preparation script generates local passwords.
APP_DB_USER=acbi_app
APP_DB_PASSWORD=CHANGE_APP_PASSWORD
APP_DB_NAME=acbi
WAREHOUSE_HOST=host.docker.internal
WAREHOUSE_PORT=5432
WAREHOUSE_DATABASE=Adventureworks
WAREHOUSE_USER=acbi_ro
WAREHOUSE_PASSWORD=CHANGE_WAREHOUSE_PASSWORD
# Local AdventureWorks has SSL disabled. Production must require verify-full.
WAREHOUSE_SSLMODE=disable
DATA_AS_OF=
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=
# Optional fallback keys, comma-separated; an error on one key moves to the next.
GROQ_API_KEYS=
STT_MODEL=whisper-large-v3-turbo
LLM_REQUESTS_PER_MINUTE=15
LLM_TOKENS_PER_MINUTE=8000
LLM_MAX_CALLS_PER_REQUEST=3
LLM_MAX_REGENERATIONS=2
REQUEST_TIMEOUT_SECONDS=30
SEND_RESULTS_TO_LLM=false
EXTERNAL_RESULTS_ENABLED=false
EXTERNAL_METADATA_ENABLED=false
WEB_PORT=8080
# Build unambiguous Structured Intents locally to spare LLM calls; false sends every question to the LLM.
LOCAL_INTENT_ENABLED=false
# Forecasting: minimum complete months and the largest hold-out error (0-1) that still allows a forecast.
FORECAST_MIN_MONTHS=24
FORECAST_MAX_MAPE=0.35


# Other providers: copy deploy/llm-providers.local.example to deploy/llm-providers.local
# and fill it in (that file is git-ignored). Order in which providers are tried:
LLM_PROVIDER_ORDER=gemini,groq,literouter
