{
  "framework": null,
  "installCommand": "cd frontend && npm install --no-audit --no-fund",
  "buildCommand": "cd frontend && npm run build",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    }
  ],
  "functions": {
    "api/index.py": {
      "maxDuration": 300,
      "includeFiles": "{backend/app,data}/**"
    }
  },
  "regions": [
    "sin1"
  ]
}
